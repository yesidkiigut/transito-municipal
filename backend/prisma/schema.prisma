datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl", "debian-openssl-3.0.x"]
}

enum Rol {
  ADMIN
  FUNCIONARIO
  CIUDADANO
}

enum TipoDocumento {
  CC
  CE
  PASAPORTE
  NIT
}

enum EstadoCiudadano {
  ACTIVO
  INACTIVO
  FALLECIDO
}

enum TipoVehiculo {
  AUTOMOVIL
  MOTOCICLETA
  CAMION
  BUS
  BUSETA
  MICROBUS
  TRACTOCAMION
}

enum ClaseServicio {
  PARTICULAR
  PUBLICO
  DIPLOMATICO
  OFICIAL
}

enum EstadoVehiculo {
  ACTIVO
  INACTIVO
  ROBADO
  DESVINCULADO
}

enum CategoriaLicencia {
  A1
  A2
  B1
  B2
  C1
  C2
  C3
}

enum EstadoLicencia {
  VIGENTE
  VENCIDA
  SUSPENDIDA
  CANCELADA
}

enum EstadoComparendo {
  PENDIENTE
  PAGADO_EXTERNO
  NOTIFICADO
  FALLADO
  APELADO
  ARCHIVADO
  EN_ACUERDO_PAGO
}

enum EstadoTramite {
  RADICADO
  EN_REVISION
  EN_ESPERA_DOC
  APROBADO
  RECHAZADO
  FINALIZADO
  CANCELADO
}

enum EstadoCita {
  DISPONIBLE
  RESERVADA
  CONFIRMADA
  CANCELADA
  ATENDIDA
  NO_SHOW
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol      @default(CIUDADANO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ciudadano Ciudadano?
}

model Ciudadano {
  id              String          @id @default(uuid())
  usuarioId       String?         @unique
  usuario         Usuario?        @relation(fields: [usuarioId], references: [id])
  tipoDocumento   TipoDocumento
  numeroDocumento String          @unique
  nombres         String
  apellidos       String
  fechaNacimiento DateTime
  correo          String
  telefono        String
  via             String
  numero1         String
  numero2         String
  barrio          String
  ciudad          String
  departamento    String
  estado          EstadoCiudadano @default(ACTIVO)
  fechaRegistro   DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  propietarios VehiculoPropietario[]
  licencias    Licencia[]
  comparendos  Comparendo[]
  tramites     Tramite[]
  citas        Cita[]
  preinscripciones Preinscripcion[]
  acuerdosPago AcuerdoPago[]
}

model Vehiculo {
  id            String         @id @default(uuid())
  placa         String         @unique
  marca         String
  linea         String
  modelo        Int
  cilindraje    Int
  color         String
  tipoVehiculo  TipoVehiculo
  claseServicio ClaseServicio
  numeroMotor   String
  numeroChasis  String
  fechaMatricula DateTime
  estado        EstadoVehiculo @default(ACTIVO)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  propietarios VehiculoPropietario[]
  tramites     Tramite[]
  comparendos  Comparendo[]
  impuestos    ImpuestoVehicular[]
  rodamientos   RodamientoMunicipal[]
}

model VehiculoPropietario {
  id          String    @id @default(uuid())
  vehiculoId  String
  ciudadanoId String
  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  esActual    Boolean   @default(true)

  vehiculo  Vehiculo  @relation(fields: [vehiculoId], references: [id])
  ciudadano Ciudadano @relation(fields: [ciudadanoId], references: [id])

  @@unique([vehiculoId, ciudadanoId, fechaInicio])
}

model Licencia {
  id                 String            @id @default(uuid())
  numeroLicencia     String            @unique
  ciudadanoId        String
  categoria          CategoriaLicencia
  fechaExpedicion    DateTime
  fechaVencimiento   DateTime
  estado             EstadoLicencia    @default(VIGENTE)
  restricciones      String[]
  organismoExpedidor String            @default("Tránsito Municipal")
  puntosAcumulados   Int               @default(12)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  ciudadano Ciudadano @relation(fields: [ciudadanoId], references: [id])
  tramites  Tramite[]
}

model TipoInfraccion {
  id             String   @id @default(uuid())
  codigo         String   @unique
  descripcion    String
  grado          Int
  valorBase      Float
  puntosDescuento Int
  articuloCNSV   String
  createdAt      DateTime @default(now())

  comparendos Comparendo[]
}

model Comparendo {
  id               String           @id @default(uuid())
  numeroComparendo String           @unique
  placaVehiculo    String
  ciudadanoId      String
  tipoInfraccionId String
  fechaInfraccion  DateTime
  lugarInfraccion  String
  agenteTransitoId String
  observaciones    String?
  evidencias       String[]
  estado           EstadoComparendo @default(PENDIENTE)
  valorMulta       Float
  gradoInfraccion  Int
  puntosDescuento  Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  vehiculo       Vehiculo       @relation(fields: [placaVehiculo], references: [placa])
  ciudadano      Ciudadano      @relation(fields: [ciudadanoId], references: [id])
  tipoInfraccion TipoInfraccion @relation(fields: [tipoInfraccionId], references: [id])
  resoluciones   Resolucion[]
}

model Resolucion {
  id               String     @id @default(uuid())
  comparendoId     String
  numeroResolucion String     @unique
  fecha            DateTime   @default(now())
  tipo             String
  motivo           String
  funcionarioId    String
  createdAt        DateTime   @default(now())

  comparendo Comparendo @relation(fields: [comparendoId], references: [id])
}

model TipoTramite {
  id                     String   @id @default(uuid())
  codigo                 String   @unique
  nombre                 String
  descripcion            String
  requisitos             String[]
  tiempoMaximoResolucion Int      @default(5)
  areaResponsable        String   @default("Operaciones")
  createdAt              DateTime @default(now())

  tramites Tramite[]
  citas    Cita[]
}

model Tramite {
  id                    String        @id @default(uuid())
  codigoTramite         String        @unique
  tipoTramiteId         String
  ciudadanoSolicitanteId String
  vehiculoId            String?
  licenciaId            String?
  estado                EstadoTramite @default(RADICADO)
  observaciones         String?
  fechaRadicado         DateTime      @default(now())
  fechaResolucion       DateTime?
  funcionarioAsignadoId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tipoTramite TipoTramite        @relation(fields: [tipoTramiteId], references: [id])
  ciudadano   Ciudadano          @relation(fields: [ciudadanoSolicitanteId], references: [id])
  vehiculo    Vehiculo?          @relation(fields: [vehiculoId], references: [id])
  licencia    Licencia?          @relation(fields: [licenciaId], references: [id])
  historial   HistorialTramite[]
}

model HistorialTramite {
  id            String        @id @default(uuid())
  tramiteId     String
  paso          String
  estadoAnterior EstadoTramite
  estadoNuevo    EstadoTramite
  funcionarioId String
  observacion   String?
  fecha         DateTime      @default(now())

  tramite Tramite @relation(fields: [tramiteId], references: [id])
}

model PuestoAtencion {
  id     String  @id @default(uuid())
  nombre String
  modulo String
  activo Boolean @default(true)

  citas Cita[]
}

model Cita {
  id               String     @id @default(uuid())
  codigoCita       String     @unique
  ciudadanoId      String
  tipoTramiteId    String
  puestoAtencionId String
  fechaCita        DateTime
  horaInicio       String
  horaFin          String
  estado           EstadoCita @default(DISPONIBLE)
  createdAt        DateTime   @default(now())

  ciudadano      Ciudadano      @relation(fields: [ciudadanoId], references: [id])
  tipoTramite    TipoTramite    @relation(fields: [tipoTramiteId], references: [id])
  puestoAtencion PuestoAtencion @relation(fields: [puestoAtencionId], references: [id])
}

enum EstadoImpuesto {
  PENDIENTE
  PAGADO
  EN_MORA
  ANULADO
  EN_ACUERDO_PAGO
}

enum EstadoPreinscripcion {
  PENDIENTE
  REVISADO
  RECHAZADO
  CONVERTIDO_EN_TRAMITE
}

enum ProveedorPasarela {
  PSE
  WOMPI
  MERCADOPAGO
}

model ImpuestoVehicular {
  id                  String         @id @default(uuid())
  placaVehiculo       String
  vigenciaFiscal      Int
  avaluoComercial     Float
  valorBaseImpuesto   Float
  sancionMora         Float          @default(0)
  interesesMora       Float          @default(0)
  descuentoProntoPago Float          @default(0)
  valorTotalPagar     Float
  estado              EstadoImpuesto @default(PENDIENTE)
  fechaVencimiento    DateTime
  fechaPago           DateTime?
  reciboPagoRef       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  vehiculo Vehiculo @relation(fields: [placaVehiculo], references: [placa])
}

model ConfiguracionPasarela {
  id            String            @id @default(uuid())
  proveedor     ProveedorPasarela @default(PSE)
  merchantId    String
  publicKey     String
  secretKey     String
  sandboxMode   Boolean           @default(true)
  activo        Boolean           @default(true)
  webhookSecret String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Preinscripcion {
  id                  String               @id @default(uuid())
  codigoPreinscripcion String              @unique
  ciudadanoId         String
  tipoTramiteCodigo   String
  placaVehiculo       String?
  datosFormulario     String
  estado              EstadoPreinscripcion @default(PENDIENTE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  ciudadano Ciudadano @relation(fields: [ciudadanoId], references: [id])
}

model RodamientoMunicipal {
  id               String   @id @default(uuid())
  placaVehiculo    String
  vigenciaAnio     Int
  valorTasa        Float
  fechaVencimiento DateTime
  estaPazYSalvo    Boolean  @default(true)
  certificadoRef   String?
  createdAt        DateTime @default(now())

  vehiculo Vehiculo @relation(fields: [placaVehiculo], references: [placa])
}

model ConfiguracionVisual {
  id                  String   @id @default(uuid())
  nombreMunicipio     String   @default("Municipio de Ejemplo")
  nombreSecretaria    String   @default("Secretaría de Tránsito y Transporte")
  lema                String   @default("Movilidad Segura, Eficiente e Innovadora")
  nitAlcaldia         String   @default("899.999.001-3")
  logoUrl             String?
  logoSecundarioUrl   String?
  escudoUrl           String?
  faviconUrl          String?
  bannerLoginUrl      String?
  colorPrimario       String   @default("#06b6d4")
  colorSecundario     String   @default("#2563eb")
  colorAcento         String   @default("#4f46e5")
  colorFondo          String   @default("#020617")
  colorSidebar        String   @default("#0f172a")
  colorNavbar         String   @default("#0f172a")
  colorTexto          String   @default("#f8fafc")
  modoOscuro          Boolean  @default(true)
  estiloBorde         String   @default("rounded-2xl")
  fuentePrincipal     String   @default("Outfit")
  presetTema          String   @default("CYAN_MODERN")
  telefonoContacto    String   @default("+57 (601) 555-0199")
  correoContacto      String   @default("contacto@transitomunicipal.gov.co")
  direccionSede       String   @default("Palacio Municipal - Cra 5 # 10-20")
  textoPiePagina      String   @default("© 2026 Alcaldía Municipal - Secretaría de Tránsito. Todos los derechos reservados.")
  portalWebUrl        String   @default("https://transitomunicipal.gov.co")
  redesSociales       String?
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum CanalPago {
  PSE
  BRE_B
  TARJETA
  VENTANILLA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  EXPIRADO
  REVERSADO
}

enum TipoConceptoPago {
  COMPARENDO
  IMPUESTO_VEHICULAR
  TRAMITE_LICENCIA
  TRAMITE_MATRICULA
  RODAMIENTO_MUNICIPAL
}

model TransaccionPago {
  id                    String        @id @default(uuid())
  referenciaPago        String        @unique
  ciudadanoId           String
  montoTotal            Float
  canalPago             CanalPago     @default(PSE)
  proveedorPasarela     String        @default("PSE_ACH")
  estadoPago            EstadoPago    @default(PENDIENTE)
  cus                   String?
  codigoTrazabilidad    String?
  ipOrigen              String?
  bancoPSE              String?
  tipoPersonaPSE        String?       @default("NATURAL")
  qrBreB                String?
  llaveBreB             String?
  fechaTransaccion      DateTime      @default(now())
  fechaAprobacion       DateTime?
  fechaExpiracion       DateTime?

  // Datos para conciliación y sincronización con HASSQL (Fase 2)
  sincronizadoHassql    Boolean       @default(false)
  fechaSincronizacion   DateTime?
  referenciaAsientoHassql String?
  intentosSync          Int           @default(0)
  logErrorSync          String?
  reciboOficialNumero   String?

  detalles              DetallePago[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model DetallePago {
  id                 String           @id @default(uuid())
  transaccionId      String
  tipoConcepto       TipoConceptoPago
  referenciaConcepto String
  descripcion        String
  codigoContable     String           @default("2.1.2.02.02")
  valorBase          Float
  descuento          Float            @default(0)
  interesesMora      Float            @default(0)
  valorFinal         Float

  transaccion        TransaccionPago  @relation(fields: [transaccionId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
}

enum TipoConexionHassql {
  WEB_SERVICE_REST
  SOAP_XML
  SQL_SERVER_DIRECT
  ARCHIVO_ASOBANCARIA_2001
}

enum EstadoLoteSync {
  EXITOSO
  PARCIAL
  FALLIDO
  EN_PROCESO
}

model ConfiguracionHassql {
  id                    String              @id @default(uuid())
  servidorHost          String              @default("https://api.hassql.com.co")
  puerto                Int                 @default(1433)
  baseDatos             String              @default("HASSQL_TRANSITO_MUNICIPAL")
  usuario               String              @default("usr_transito_sync")
  password              String              @default("Hassql_2026_Secure!")
  tipoConexion          TipoConexionHassql  @default(WEB_SERVICE_REST)
  tokenApi              String?             @default("hsql_tok_live_987654321_transito")
  endpointRecaudo       String              @default("https://api.hassql.com.co/v1/recaudo/transito")
  horaCierreFiscal      String              @default("23:59")
  activo                Boolean             @default(true)
  autoSincronizar       Boolean             @default(true)
  formatoAsobancaria    Boolean             @default(true)
  codigoEntidadHassql   String              @default("MUN-TRANSITO-001")
  cuentaBancariaRecaudo String              @default("CTA-CTE-123456789-BANCOLOMBIA")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model LoteSincronizacionHassql {
  id                    String              @id @default(uuid())
  codigoLote            String              @unique
  fechaInicio           DateTime
  fechaFin              DateTime
  totalTransacciones    Int
  totalRecaudado        Float
  totalPSE              Float               @default(0)
  totalBreB             Float               @default(0)
  estado                EstadoLoteSync      @default(EXITOSO)
  comprobanteHassqlId   String?
  respuestaServidor     String?
  archivoPlanoGenerado  String?
  detallesContables     String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

// ==========================================
// MODELOS PARAMÉTRICOS NORMATIVOS
// ==========================================

model ParametroAnual {
  id                      String   @id @default(uuid())
  vigenciaFiscal          Int      @unique
  uvtValor                Float
  smmlvValor              Float
  sancionMinimaMora       Float
  valorCursoPedagogico    Float    @default(0)
  porcentajeDescuentoProntoPago Float @default(10.0)
  fechaLimiteProntoPago   DateTime
  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model TasaInteresMora {
  id                       String   @id @default(uuid())
  anio                     Int
  mes                      Int
  tasaEfectivaAnual        Float
  tasaNominalMensual       Float
  tasaDiaria               Float
  resolucionSuperfinanciera String?
  activo                   Boolean  @default(true)
  createdAt                DateTime @default(now())

  @@unique([anio, mes])
}

model RangoTarifaImpuesto {
  id               String   @id @default(uuid())
  vigenciaFiscal   Int
  rangoDesdeUVT    Float
  rangoHastaUVT    Float
  porcentajeTarifa Float
  descripcion      String
  createdAt        DateTime @default(now())

  @@unique([vigenciaFiscal, rangoDesdeUVT])
}

model ReglaDescuentoLey {
  id                 String   @id @default(uuid())
  codigo             String   @unique
  descripcion        String
  diasHabilesMin     Int
  diasHabilesMax     Int
  porcentajeDescuento Float
  requiereCurso      Boolean  @default(true)
  leyReferencia      String   @default("Ley 769 de 2002 / Ley 2161 de 2021")
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model TarifaRodamiento {
  id            String        @id @default(uuid())
  vigenciaAnio  Int
  tipoVehiculo  TipoVehiculo
  claseServicio ClaseServicio
  valorTasa     Float
  createdAt     DateTime      @default(now())

  @@unique([vigenciaAnio, tipoVehiculo, claseServicio])
}

// ==========================================
// MÓDULO DE ACUERDOS Y FINANCIACIÓN DE PAGO
// ==========================================

enum EstadoAcuerdo {
  BORRADOR
  ACTIVO
  AL_DIA
  EN_MORA
  PAGADO_TOTAL
  INCUMPLIDO
  ANULADO
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
  EN_MORA
  ANULADA
}

model AcuerdoPago {
  id                       String        @id @default(uuid())
  codigoAcuerdo            String        @unique
  ciudadanoId              String
  placaVehiculo            String?
  montoTotalDeuda          Float
  montoCuotaInicial        Float
  saldoFinanciar           Float
  numeroCuotas             Int
  tasaInteresFinanciacion  Float         @default(1.5)
  valorCuotaFija           Float
  estado                   EstadoAcuerdo @default(ACTIVO)
  fechaSuscripcion         DateTime      @default(now())
  fechaPrimerVencimiento   DateTime
  observaciones            String?
  funcionarioRadicaId      String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  ciudadano                Ciudadano            @relation(fields: [ciudadanoId], references: [id])
  cuotas                   CuotaAcuerdoPago[]
  detallesDeuda            DetalleDeudaAcuerdo[]
}

model CuotaAcuerdoPago {
  id                  String      @id @default(uuid())
  acuerdoId           String
  numeroCuota         Int
  valorCapital        Float
  valorInteres        Float
  valorTotalCuota     Float
  saldoRestante       Float
  fechaVencimiento    DateTime
  fechaPago           DateTime?
  estado              EstadoCuota @default(PENDIENTE)
  reciboPagoRef       String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  acuerdo             AcuerdoPago @relation(fields: [acuerdoId], references: [id], onDelete: Cascade)

  @@unique([acuerdoId, numeroCuota])
}

model DetalleDeudaAcuerdo {
  id                  String           @id @default(uuid())
  acuerdoId           String
  tipoConcepto        TipoConceptoPago
  referenciaConcepto  String
  montoCapital        Float
  montoIntereses      Float
  montoTotal          Float
  createdAt           DateTime         @default(now())

  acuerdo             AcuerdoPago      @relation(fields: [acuerdoId], references: [id], onDelete: Cascade)
}

