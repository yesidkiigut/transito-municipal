# .gitignore for transito-municipal monorepo
# -------------------------------------------------
# Node.js dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment files (contain secrets)
.env
.env.example

# Build artefacts
# Next.js (backend)
.next/
# Vite (frontend)
frontend/dist/
frontend/.vite/
# General distribution folder (if used)
/dist/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS & editor artefacts
.DS_Store
Thumbs.db
.idea/
.vscode/

# Prisma generated client (optional, can be committed if desired)
# prisma/client/

# Misc
coverage/
